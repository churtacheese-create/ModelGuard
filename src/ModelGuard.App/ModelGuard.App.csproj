<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ModelGuard.Core\ModelGuard.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\ModelGuard.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup><Resource Include="Assets\ModelGuard.ico" /></ItemGroup>

  <ItemGroup><Content Include="..\..\corpus\**\*"><Link>corpus\%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content></ItemGroup>

</Project>
